<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.CustomMealFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom meal"
        android:layout_gravity="center"/>

    <RadioGroup
        android:id="@+id/customMealGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/skladnik1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Składnik 1 - 10 zł"
            android:layout_gravity="center"/>

        <RadioButton
            android:id="@+id/skladnik2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Składnik 2 - 5 zł"
            android:layout_gravity="center"/>

    </RadioGroup>

    <Button
        android:id="@+id/summaryFragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Podsumowanie"
        android:layout_gravity="center"/>

</LinearLayout>
